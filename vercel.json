{
  "rewrites": [
    {
      "source": "/_mintlify/:path*",
      "destination": "https://acknowledgements.mintlify.site/_mintlify/:path*"
    },
    {
      "source": "/mintlify-assets/:path+",
      "destination": "https://acknowledgements.mintlify.site/mintlify-assets/:path+"
    },
    {
      "source": "/docs",
      "destination": "https://acknowledgements.mintlify.site/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://acknowledgements.mintlify.site/docs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
